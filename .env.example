# Copy this file to .env and fill in your key. Never commit .env to GitHub.
REVENIUM_METERING_API_KEY=rev_mk_paste_your_key_here
REVENIUM_METERING_BASE_URL=https://api.revenium.ai
REVENIUM_PRODUCT_NAME=cost-aware-llm-gateway
# Set to true only if Revenium shows $0 cost for the Nova models
REVENIUM_SEND_GATEWAY_COST=false
# Where budgets are stored: dynamodb (real) or memory (resets on restart)
BUDGET_BACKEND=dynamodb
BUDGET_TABLE=mohan-gateway-budgets
